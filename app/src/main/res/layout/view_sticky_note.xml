<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="240dp"
    android:layout_height="200dp"
    android:background="@drawable/bg_sticky"
    android:elevation="8dp"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/stickyHeader"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:background="@drawable/bg_sticky_header"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/stickyTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="메모"
            android:textColor="#99000000"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/stickyDelete"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/sticky_delete"
            android:textColor="#99000000"
            android:textSize="18sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/stickyText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@null"
        android:gravity="top|start"
        android:hint="@string/sticky_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:padding="8dp"
        android:textColor="#FF1A1A1A"
        android:textColorHint="#66000000"
        android:textSize="13sp" />
</LinearLayout>
